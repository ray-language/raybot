// raybot — the gateway wire protocol (Discord-shaped JSON over websocket).
//
// op 10 HELLO {heartbeat_interval} · op 2 IDENTIFY {token} · op 1 HEARTBEAT
// (seq) · op 11 ACK · op 0 DISPATCH {t, s, d} · op 100 REPLY (local-mode
// extension: against real Discord replies go through the REST API, out of v1).
import std/json;
from std/json import Json;

pub struct Incoming {
    op: int,
    t: string,
    seq: int,
    d: Json,
}

pub fn parse_frame(text: string) -> Option<Incoming> {
    match (json.parse(text)) {
        Result.Err(e) => Option.None,
        Result.Ok(j) => {
            let op = match (json.get_int(j, "op")) {
                Option.Some(n) => n,
                Option.None => {
                    return Option.None;
                },
            };
            let t = match (json.get_string(j, "t")) {
                Option.Some(s) => s,
                Option.None => "",
            };
            let seq = match (json.get_int(j, "s")) {
                Option.Some(n) => n,
                Option.None => 0,
            };
            let d = match (json.member(j, "d")) {
                Option.Some(x) => x,
                Option.None => Json.JNull,
            };
            Option.Some(Incoming { op: op, t: t, seq: seq, d: d })
        },
    }
}

// The envelope every frame shares; the caller adds `d`: a nested `json.obj()`, a number,
// or a `Json` value such as `Json.JNull` (`Json` implements `ToJson` since raylang 1.27.13).
fn frame(op: int) -> json.Obj {
    json.obj().field("op", op)
}

fn event(t: string, seq: int) -> json.Obj {
    frame(0).field("t", t).field("s", seq)
}

pub fn hello(interval_ms: int) -> string {
    frame(10).field("d", json.obj().field("heartbeat_interval", interval_ms)).render()
}

pub fn identify(token: string) -> string {
    frame(2).field("d", json.obj().field("token", token)).render()
}

pub fn heartbeat(seq: int) -> string {
    frame(1).field("d", seq).render()
}

pub fn ack() -> string {
    frame(11).field("d", Json.JNull).render()
}

pub fn dispatch(t: string, seq: int, d: Json) -> string {
    event(t, seq).field("d", d).render()
}

pub fn message_create(seq: int, channel: string, author: string, content: string) -> string {
    let d = json.obj().field("channel", channel).field("author", author).field("content", content);
    event("MESSAGE_CREATE", seq).field("d", d).render()
}

pub fn reply(channel: string, content: string) -> string {
    frame(100).field("d", json.obj().field("channel", channel).field("content", content)).render()
}

pub fn d_string(d: Json, key: string) -> string {
    match (json.get_string(d, key)) {
        Option.Some(s) => s,
        Option.None => "",
    }
}

pub fn d_int(d: Json, key: string) -> int {
    match (json.get_int(d, key)) {
        Option.Some(n) => n,
        Option.None => 0,
    }
}
